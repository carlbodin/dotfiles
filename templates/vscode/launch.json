{
  "version": "0.2.0",
  "configurations": [
    // POETRY/UV ENV
    {
      "name": "Program in Poetry/UV Environment",
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python3.10", // Virtual environment.
      "program": "${workspaceFolder}/script.py", // Main Script.
      "args": ["extract", "--output-dir", "/tmp/vics_extract"] // Args.
    },
    // PYTEST
    {
      "name": "Pytest",
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python3.10",
      "module": "pytest",
      "args": ["tests/", "--force_cpu"],
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    // C++ DEBUGGING
    {
      "name": "C++ Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/your_cpp_executable", // Path to your C++ executable.
      "args": [], // Arguments for your C++ program.
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
