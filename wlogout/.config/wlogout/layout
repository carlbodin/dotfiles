{
    "label": "suspend",
    "text" : "󰏤",
    "action": "systemctl suspend",
    "keybind": "p"
}

{
    "label": "hibernate",
    "text" : "󰤄",
    "action" : "systemctl hibernate",
    "keybind": "h"
}

{
    "label": "reboot",
    "text" : "󰜉",
    "action": "systemctl reboot || loginctl reboot",
    "keybind": "r"
}

{
    "label": "shutdown",
    "text" : "󰐥",
    "action": "systemctl poweroff || loginctl poweroff",
    "keybind": "s"
}
