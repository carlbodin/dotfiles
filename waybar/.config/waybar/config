{
  "layer": "bottom",
  "position": "top",
  "margin": "8 8 0 8",
  "spacing": 12,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/notification",
    "group/1",
    "tray"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "group/connections",
    "pulseaudio",
    "battery",
    "clock"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "empty": ""
    },
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    }
  },
  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "clock": {
    "format": "<span font_family='Noto Sans'>{:%H:%M}</span>",
    "format-alt": "<span font_family='Noto Sans'>{:%A %d %B %H:%M}</span>",
    "interval": 1,
    "tooltip-format": "<span font_family='Noto Sans'><tt>{calendar}</tt></span>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b><span font_family='Noto Sans'>{}</span></b></span>",
        "days": "<span color='#ecc6d9'><b><span font_family='Noto Sans'>{}</span></b></span>",
        "weeks": "<span color='#99ffdd'><b><span font_family='Noto Sans'>W{}</span></b></span>",
        "weekdays": "<span color='#ffcc66'><b><span font_family='Noto Sans'>{}</span></b></span>",
        "today": "<span color='#ff6699'><b><u><span font_family='Noto Sans'>{}</span></u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": "16",
    "on-click": "activate",
    "on-click-right": "close",
    "tooltip-format": "<span font_family='Noto Sans'>Go to {title}</span>",
    "ignore-list": []
  },
  "tray": {
    "icon-size": 14,
    "format": "{icon}",
    "spacing": 10
  },
  "group/1": {
    "orientation": "horizontal",
    "modules": [
      "idle_inhibitor",
      "custom/colorpicker",
      "custom/clipboard"
    ]
  },
  "idle_inhibitor": {
    "format": "<span size='small'>{icon}</span>",
    "tooltip-format": "<span font_family='Noto Sans'>{}</span>",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "custom/colorpicker": {
    "format": "<span size='small'>{}</span>",
    "return-type": "json",
    "interval": "once",
    "exec": "~/.config/waybar/scripts/colorpicker.sh -j",
    "on-click": "~/.config/waybar/scripts/colorpicker.sh",
    "signal": 1
  },
  "custom/clipboard": {
    "format": "󰨸",
    "on-click": "~/.config/waybar/scripts/cliphist_menu.sh",
    "on-click-right": "~/.config/waybar/scripts/cliphist_menu.sh --delete",
    "on-click-middle": "~/.config/waybar/scripts/cliphist_menu.sh --wipe",
    "tooltip": true,
    "tooltip-format": "<span font_family='Noto Sans'>Left-click: Select item\n\nRight-click: Delete item\n\nMiddle-click: Wipe history</span>"
  },
  "group/connections": {
    "orientation": "horizontal",
    "modules": [
      "bluetooth",
      "network"
    ]
  },
  "bluetooth": {
    "format-on": "󰂯",
    "format-connected": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected-battery": "󰂯 󰁹 <span font_family='Noto Sans'>{device_battery_percentage}%</span>",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%",
    "on-click": "blueman-manager"
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-disconnected": "<span font_family='Noto Sans'>Error</span>",
    "tooltip-format-wifi": "<span font_family='Noto Sans'>{essid} ({signalStrength}%)</span>  ",
    "tooltip-format-ethernet": "<span font_family='Noto Sans'>{ifname}</span> 🖧 ",
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "{icon} <span font_family='Noto Sans'>{volume}%</span>",
    "format-bluetooth": "{icon} <span font_family='Noto Sans'>{volume}%</span>",
    "format-bluetooth-muted": "{icon} ",
    "format-muted": "󰝟 <span font_family='Noto Sans'>{format_source}</span>",
    "format-source": "<span font_family='Noto Sans'>{volume}%</span>",
    "format-source-muted": "",
    "tooltip-format": "<span font_family='Noto Sans'>{}</span>",
    "format-icons": {
      "default": [
        "",
        "",
        " "
      ]
    },
    "max-volume": 150,
    "on-click": "pavucontrol"
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },
  "battery": {
    "interval": 30,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "tooltip-format": "<span font_family='Noto Sans'>{}</span>",
    "format": "{icon} <span font_family='Noto Sans'>{capacity}%</span>",
    "format-charging": "󰂄 <span font_family='Noto Sans'>{capacity}%</span>",
    "format-plugged": "󰂄  <span font_family='Noto Sans'>{capacity}%</span>",
    "format-alt": "{icon} <span font_family='Noto Sans'>{time}</span>",
    "format-icons": [
      "󰁻",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰂂",
      "󰁹"
    ]
  }
}
