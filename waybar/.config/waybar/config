{
  "layer": "bottom",
  "position": "top",
  "margin": "8 8 0 8",
  "spacing": 6,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/notification",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "group/clocks"
  ],
  "modules-right": [
    "tray",
    "group/tools_other",
    "group/connections",
    "pulseaudio"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "empty": ""
    },
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"{}\" })'"
  },
  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "clock#weekday": {
    "format": "{:%A}",
    "tooltip": false
  },
  "clock#time": {
    "format": "{:%H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "clock#date": {
    "format": "{:%d %B}",
    "tooltip": false
  },
  "group/clocks": {
    "orientation": "horizontal",
    "modules": [
      "clock#weekday",
      "clock#time",
      "clock#date"
    ]
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": "16",
    "on-click": "activate",
    "on-click-right": "close",
    "tooltip-format": "Go to {title}",
    "ignore-list": []
  },
  "tray": {
    "icon-size": 14,
    "format": "{icon}",
    "spacing": 10
  },
  "group/tools_other": {
    "orientation": "horizontal",
    "modules": [
      "idle_inhibitor",
      "custom/colorpicker",
      "custom/clipboard"
    ]
  },
  "idle_inhibitor": {
    "format": "<span size='small'>{icon}</span>",
    "tooltip-format": "{}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "custom/colorpicker": {
    "format": "<span size='small'>{}</span>",
    "return-type": "json",
    "interval": "once",
    "exec": "~/.config/waybar/scripts/colorpicker.sh -j",
    "on-click": "~/.config/waybar/scripts/colorpicker.sh",
    "signal": 1
  },
  "custom/clipboard": {
    "format": "󰨸",
    "on-click": "~/.config/waybar/scripts/cliphist_menu.sh",
    "on-click-right": "~/.config/waybar/scripts/cliphist_menu.sh --delete",
    "on-click-middle": "~/.config/waybar/scripts/cliphist_menu.sh --wipe",
    "tooltip": true,
    "tooltip-format": "<b>Left-click:</b> Select item\n\n<b>Right-click:</b> Delete item\n\n<b>Middle-click:</b> Wipe history"
  },
  "group/connections": {
    "orientation": "horizontal",
    "modules": [
      "bluetooth",
      "network"
    ]
  },
  "bluetooth": {
    "format-on": "󰂯",
    "format-connected": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected-battery": "󰂯 󰁹 {device_battery_percentage}%",
    "tooltip-format": "<b>Controller</b>\n{controller_alias} {controller_address}\n\n<b>Devices</b> {num_connections}",
    "tooltip-format-connected": "<b>Controller</b>\n{controller_alias} {controller_address}\n\n<b>Devices</b>\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias} {device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} {device_battery_percentage}%\n{device_address}",
    "on-click": "blueman-manager"
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-disconnected": "Error",
    "tooltip-format-wifi": "{essid} {signalStrength}%",
    "tooltip-format-ethernet": "{ifname}",
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-bluetooth-muted": "{icon} ",
    "format-muted": "󰝟 {format_source}",
    "format-source": "{volume}%",
    "format-source-muted": "",
    "tooltip-format": "{}",
    "format-icons": {
      "default": [
        "",
        "",
        " "
      ]
    },
    "max-volume": 150,
    "on-click": "pavucontrol"
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },
  "battery": {
    "interval": 30,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "tooltip-format": "{}",
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄  {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": [
      "󰁻",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰂂",
      "󰁹"
    ]
  }
}
