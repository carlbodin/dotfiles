# Documentation: https://man.archlinux.org/man/wofi.5.en
# Don't comment on setting lines, it will break the setting making it run default.

[config]
# Appearance
width=500px
location=center
orientation=vertical
allow_images=true
image_size=30
columns=1
lines=9
hide_scroll=true

# Search
show=drun
prompt=Search...
insensitive=true
allow_markup=false
sort_order=default

# Behavior
term=alacritty
close_on_focus_loss=true
single_click=true
no_actions=true
key_expand=Tab
